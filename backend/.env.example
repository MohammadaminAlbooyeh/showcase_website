# Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,showcase-website-backend.onrender.com

# Database
# For development: leave empty to use SQLite
# For production: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Email Configuration (Gmail SMTP)
# Get app-specific password: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Admin Contact Email
ADMIN_EMAIL=amin.albooyeh@gmail.com

# Redis Cache (for production)
# Optional: redis://default:password@localhost:6379/0
# REDIS_URL=redis://default:password@localhost:6379/0
